<%#
  Expected locals:
    instructor       — profile row from InstructorProfile.findAll() or Availability.searchOnDate()
    compact          — optional bool; hides type-of-availability badges (default false)
    showAvailability — optional bool; when true shows the date-availability status strip
%>
<%
    // Helper used only when showAvailability is true
    const fmtTime = (t) => {
        if (!t) return '';
        const [h, m] = String(t).split(':');
        const hour = parseInt(h, 10);
        return `${hour % 12 || 12}:${m} ${hour < 12 ? 'AM' : 'PM'}`;
    };
%>
<div class="card border-0 shadow-sm h-100 instructor-card">
    <div class="card-body p-4">

        <!-- Photo + Name header -->
        <div class="d-flex align-items-center gap-3 mb-3">
            <% if (instructor.profile_photo_url) { %>
                <img
                    src="<%= instructor.profile_photo_url %>"
                    alt="<%= instructor.first_name %> <%= instructor.last_name %>"
                    class="rounded-circle object-fit-cover flex-shrink-0"
                    width="64" height="64"
                    style="object-fit:cover;">
            <% } else { %>
                <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:64px;height:64px;">
                    <i class="bi bi-person-fill text-secondary fs-3"></i>
                </div>
            <% } %>
            <div class="overflow-hidden">
                <h6 class="fw-bold mb-0 text-truncate">
                    <%= instructor.first_name %> <%= instructor.last_name %>
                </h6>
                <% if (instructor.rank) { %>
                    <small class="text-muted"><%= instructor.rank %></small>
                <% } %>
            </div>
        </div>

        <!-- Certification level -->
        <% if (instructor.certification_level) { %>
            <div class="mb-2">
                <span class="badge bg-danger bg-opacity-10 text-danger fw-normal">
                    <i class="bi bi-patch-check me-1"></i><%= instructor.certification_level %>
                </span>
            </div>
        <% } %>

        <!-- School + Location -->
        <% if (instructor.school_name) { %>
            <p class="small text-muted mb-1">
                <i class="bi bi-building me-1"></i><%= instructor.school_name %>
            </p>
        <% } %>
        <% if (instructor.city || instructor.state) { %>
            <p class="small text-muted mb-2">
                <i class="bi bi-geo-alt me-1"></i><%= [instructor.city, instructor.state].filter(Boolean).join(', ') %>
            </p>
        <% } %>

        <!-- Specialties (first 3) -->
        <% if (instructor.specialties && instructor.specialties.length > 0) { %>
            <div class="d-flex flex-wrap gap-1 mb-3">
                <% instructor.specialties.slice(0, 3).forEach(s => { %>
                    <span class="badge bg-light text-dark border fw-normal small"><%= s %></span>
                <% }) %>
                <% if (instructor.specialties.length > 3) { %>
                    <span class="badge bg-light text-muted border fw-normal small">
                        +<%= instructor.specialties.length - 3 %> more
                    </span>
                <% } %>
            </div>
        <% } %>

        <!-- Date availability status (shown in search-by-date results) -->
        <% if (showAvailability) { %>
            <div class="mb-2">
                <% if (instructor.explicit_available === 1) { %>
                    <span class="badge bg-success px-2 py-1 fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i>Available
                        <% if (instructor.start_time) { %>
                            from <%= fmtTime(instructor.start_time) %>
                            <% if (instructor.end_time) { %> – <%= fmtTime(instructor.end_time) %><% } %>
                        <% } %>
                    </span>
                <% } else { %>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-1 fw-normal">
                        <i class="bi bi-check-circle me-1"></i>Available (default)
                    </span>
                <% } %>
                <% if (instructor.travel_radius_miles) { %>
                    <span class="badge bg-light text-muted border fw-normal ms-1" style="font-size:.65rem;">
                        <i class="bi bi-car-front me-1"></i><%= instructor.travel_radius_miles %> mi
                    </span>
                <% } %>
            </div>
        <% } %>

        <!-- General availability type badges (non-date-search) -->
        <% if (!compact && !showAvailability) { %>
            <div class="d-flex flex-wrap gap-1 mb-3">
                <% if (instructor.is_available_for_events) { %>
                    <span class="badge bg-success bg-opacity-10 text-success fw-normal small">
                        <i class="bi bi-calendar-check me-1"></i>Events
                    </span>
                <% } %>
                <% if (instructor.is_available_for_testing) { %>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-normal small">
                        <i class="bi bi-award me-1"></i>Testing
                    </span>
                <% } %>
                <% if (instructor.is_available_for_seminars) { %>
                    <span class="badge bg-warning bg-opacity-10 text-warning fw-normal small">
                        <i class="bi bi-mortarboard me-1"></i>Seminars
                    </span>
                <% } %>
                <% if (instructor.travel_radius_miles) { %>
                    <span class="badge bg-light text-muted border fw-normal small">
                        <i class="bi bi-car-front me-1"></i><%= instructor.travel_radius_miles %> mi
                    </span>
                <% } %>
            </div>
        <% } %>

    </div>

    <div class="card-footer bg-white border-top">
        <a href="/instructors/<%= instructor.id %>" class="btn btn-sm btn-outline-danger w-100">
            View Profile
        </a>
    </div>
</div>
