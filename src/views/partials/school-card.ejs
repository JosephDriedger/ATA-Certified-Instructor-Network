<div class="card border-0 shadow-sm h-100">
    <div class="card-body p-4">

        <!-- Logo + Name -->
        <div class="d-flex align-items-center gap-3 mb-3">
            <% if (school.logo_url) { %>
                <img src="<%= school.logo_url %>"
                     alt="<%= school.name %> logo"
                     class="rounded flex-shrink-0"
                     width="56" height="56"
                     style="object-fit:contain;">
            <% } else { %>
                <div class="rounded bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:56px;height:56px;">
                    <i class="bi bi-building text-danger fs-4"></i>
                </div>
            <% } %>
            <div class="overflow-hidden">
                <h6 class="fw-bold mb-0 text-truncate"><%= school.name %></h6>
                <% if (school.head_instructor_name) { %>
                    <small class="text-muted"><%= school.head_instructor_name %></small>
                <% } %>
            </div>
        </div>

        <!-- Location -->
        <% if (school.city || school.state) { %>
            <p class="small text-muted mb-1">
                <i class="bi bi-geo-alt me-1"></i>
                <%= [school.city, school.state].filter(Boolean).join(', ') %>
            </p>
        <% } %>

        <!-- Instructor count -->
        <% if (school.instructor_count > 0) { %>
            <p class="small text-muted mb-0">
                <i class="bi bi-people me-1"></i>
                <%= school.instructor_count %> instructor<%= school.instructor_count !== 1 ? 's' : '' %>
            </p>
        <% } %>

    </div>
    <div class="card-footer bg-white border-top">
        <a href="/schools/<%= school.slug %>" class="btn btn-sm btn-outline-danger w-100">
            View School
        </a>
    </div>
</div>
