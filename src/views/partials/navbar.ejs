<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">

        <a class="navbar-brand fw-bold fs-5" href="/">
            <span class="text-danger">ATA</span> Instructor Network
        </a>

        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">

            <!-- Public nav links -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link <%= currentPath.startsWith('/instructors') ? 'active' : '' %>"
                       href="/instructors">
                        <i class="bi bi-person-badge me-1"></i>Instructors
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath.startsWith('/schools') ? 'active' : '' %>"
                       href="/schools">
                        <i class="bi bi-building me-1"></i>Schools
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath.startsWith('/events') ? 'active' : '' %>"
                       href="/events">
                        <i class="bi bi-calendar-event me-1"></i>Events
                    </a>
                </li>
                <% if (user) { %>
                <li class="nav-item">
                    <a class="nav-link <%= currentPath.startsWith('/bookings') ? 'active' : '' %>"
                       href="/bookings">
                        <i class="bi bi-journal-check me-1"></i>Bookings
                    </a>
                </li>
                <% } %>
            </ul>

            <!-- Auth section -->
            <ul class="navbar-nav align-items-lg-center gap-2">
                <% if (user) { %>

                    <!-- Direct messages with unread badge -->
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="/messages" title="Messages">
                            <i class="bi bi-chat-dots fs-5"></i>
                            <% if (unreadMessageCount > 0) { %>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      style="font-size:.6rem; padding:.25em .45em;">
                                    <%= unreadMessageCount > 99 ? '99+' : unreadMessageCount %>
                                    <span class="visually-hidden">unread messages</span>
                                </span>
                            <% } %>
                        </a>
                    </li>

                    <!-- Notification bell with unread badge -->
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="/notifications" title="Notifications">
                            <i class="bi bi-bell fs-5"></i>
                            <% if (unreadNotificationCount > 0) { %>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                      style="font-size:.6rem; padding:.25em .45em;">
                                    <%= unreadNotificationCount > 99 ? '99+' : unreadNotificationCount %>
                                    <span class="visually-hidden">unread notifications</span>
                                </span>
                            <% } %>
                        </a>
                    </li>

                    <!-- User dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-lg-inline"><%= user.displayName %></span>
                            <span class="badge bg-secondary fw-normal small"><%= user.roleLabel %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <span class="dropdown-item-text text-muted small px-3">
                                    <%= user.displayName %>
                                </span>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item" href="/dashboard">
                                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="/logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                </a>
                            </li>
                        </ul>
                    </li>

                <% } else { %>

                    <li class="nav-item">
                        <a class="nav-link" href="/login">Sign In</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-danger btn-sm px-3" href="/register">Get Started</a>
                    </li>

                <% } %>
            </ul>

        </div>
    </div>
</nav>
