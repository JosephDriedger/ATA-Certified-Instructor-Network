<%
    const fmtDate = (d) => d
        ? new Date(d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })
        : '—';

    const fmtRelative = (d) => {
        if (!d) return '';
        const diff = Date.now() - new Date(d).getTime();
        if (diff < 3600000)   return `${Math.floor(diff / 60000)}m ago`;
        if (diff < 86400000)  return `${Math.floor(diff / 3600000)}h ago`;
        if (diff < 604800000) return `${Math.floor(diff / 86400000)}d ago`;
        return fmtDate(d);
    };

    const STATUS_BADGE = {
        draft:     'bg-secondary',
        published: 'bg-success',
        completed: 'bg-primary',
        cancelled: 'bg-danger'
    };

    const ROLE_BADGE = {
        administrator: 'bg-danger',
        school_owner:  'bg-primary',
        instructor:    'bg-success'
    };
%>

<!-- Header -->
<div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1">Admin Dashboard</h2>
        <p class="text-muted small mb-0">
            Welcome back, <strong><%= user.displayName %></strong> ·
            <span class="badge bg-danger">Administrator</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/admin/users"          class="btn btn-sm btn-outline-secondary">Manage Users</a>
        <a href="/admin/certifications" class="btn btn-sm btn-outline-secondary">Verify Certs</a>
    </div>
</div>

<!-- ── Primary stat cards ──────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="bg-danger bg-opacity-10 rounded-3 p-3 flex-shrink-0">
                    <i class="bi bi-people-fill text-danger fs-4"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1 mb-1"><%= stats.users.total %></div>
                    <div class="text-muted small">Total Users</div>
                    <% if (stats.users.new_30d > 0) { %>
                        <div class="text-success" style="font-size:.7rem;">
                            +<%= stats.users.new_30d %> this month
                        </div>
                    <% } %>
                </div>
            </div>
            <a href="/admin/users" class="card-footer bg-white border-top text-decoration-none text-muted small py-2 px-3">
                View all users <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="bg-success bg-opacity-10 rounded-3 p-3 flex-shrink-0">
                    <i class="bi bi-building-fill text-success fs-4"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1 mb-1"><%= stats.schools.active %></div>
                    <div class="text-muted small">Active Schools</div>
                    <div style="font-size:.7rem;" class="text-muted"><%= stats.schools.total %> total</div>
                </div>
            </div>
            <a href="/schools" class="card-footer bg-white border-top text-decoration-none text-muted small py-2 px-3">
                View all schools <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="bg-primary bg-opacity-10 rounded-3 p-3 flex-shrink-0">
                    <i class="bi bi-calendar-event-fill text-primary fs-4"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1 mb-1"><%= stats.events.upcoming %></div>
                    <div class="text-muted small">Upcoming Events</div>
                    <div style="font-size:.7rem;" class="text-muted"><%= stats.events.total %> total</div>
                </div>
            </div>
            <a href="/events" class="card-footer bg-white border-top text-decoration-none text-muted small py-2 px-3">
                View all events <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <% const pendingTotal = parseInt(stats.pendingCerts) + parseInt(stats.pendingRequests); %>
                <div class="<%= pendingTotal > 0 ? 'bg-warning bg-opacity-10' : 'bg-secondary bg-opacity-10' %> rounded-3 p-3 flex-shrink-0">
                    <i class="bi bi-exclamation-circle-fill <%= pendingTotal > 0 ? 'text-warning' : 'text-secondary' %> fs-4"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1 mb-1"><%= pendingTotal %></div>
                    <div class="text-muted small">Pending Actions</div>
                    <div style="font-size:.7rem;" class="text-muted">
                        <%= stats.pendingCerts %> certs · <%= stats.pendingRequests %> requests
                    </div>
                </div>
            </div>
            <a href="/admin/certifications" class="card-footer bg-white border-top text-decoration-none text-muted small py-2 px-3">
                Review now <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

</div>

<!-- ── User breakdown + Event pipeline ────────────────────────────────────── -->
<div class="row g-4 mb-4">

    <!-- User role breakdown -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom fw-semibold py-3">
                <i class="bi bi-bar-chart-fill text-danger me-2"></i>Users by Role
            </div>
            <div class="card-body p-4">
                <% const roles = [
                    { label: 'Instructors',   key: 'instructor',    color: 'bg-success', icon: 'bi-person-badge-fill' },
                    { label: 'School Owners', key: 'school_owner',  color: 'bg-primary', icon: 'bi-building-fill' },
                    { label: 'Administrators',key: 'administrator', color: 'bg-danger',  icon: 'bi-shield-fill' }
                ]; %>
                <% roles.forEach(r => { %>
                    <% const count = stats.users.byRole[r.key] || 0; %>
                    <% const pct   = stats.users.active > 0 ? Math.round((count / stats.users.active) * 100) : 0; %>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-medium d-flex align-items-center gap-2">
                                <i class="bi <%= r.icon %> text-muted"></i>
                                <%= r.label %>
                            </span>
                            <span class="fw-bold"><%= count %></span>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar <%= r.color %>"
                                 role="progressbar"
                                 style="width:<%= pct %>%"></div>
                        </div>
                    </div>
                <% }) %>
                <div class="border-top pt-3 mt-1 d-flex justify-content-between">
                    <span class="small text-muted">Active users</span>
                    <span class="fw-semibold small"><%= stats.users.active %> / <%= stats.users.total %></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Event status pipeline -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom fw-semibold py-3">
                <i class="bi bi-calendar3 text-danger me-2"></i>Event Pipeline
            </div>
            <div class="card-body p-4">
                <% const pipeline = [
                    { label: 'Upcoming (published)', value: stats.events.upcoming,  color: 'text-success', icon: 'bi-play-circle-fill'  },
                    { label: 'Draft',                value: stats.events.drafts,    color: 'text-secondary',icon: 'bi-file-earmark-fill' },
                    { label: 'Completed',            value: stats.events.completed, color: 'text-primary', icon: 'bi-check-circle-fill' },
                    { label: 'Cancelled',            value: stats.events.cancelled, color: 'text-danger',  icon: 'bi-x-circle-fill'     }
                ]; %>
                <% pipeline.forEach(p => { %>
                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                        <span class="small d-flex align-items-center gap-2">
                            <i class="bi <%= p.icon %> <%= p.color %>"></i>
                            <%= p.label %>
                        </span>
                        <span class="fw-bold"><%= p.value ?? 0 %></span>
                    </div>
                <% }) %>
                <div class="pt-3 d-flex justify-content-between">
                    <span class="small text-muted">Total events</span>
                    <span class="fw-semibold small"><%= stats.events.total %></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending actions card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom fw-semibold py-3">
                <i class="bi bi-lightning-fill text-danger me-2"></i>Quick Actions
            </div>
            <div class="card-body p-0">
                <a href="/admin/certifications" class="list-group-item list-group-item-action px-4 py-3 d-flex align-items-center gap-3 border-0 border-bottom">
                    <div class="bg-warning bg-opacity-10 rounded p-2 flex-shrink-0">
                        <i class="bi bi-patch-check-fill text-warning"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium small">Verify Certifications</div>
                        <div class="text-muted" style="font-size:.72rem;"><%= stats.pendingCerts %> pending review</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a href="/bookings" class="list-group-item list-group-item-action px-4 py-3 d-flex align-items-center gap-3 border-0 border-bottom">
                    <div class="bg-danger bg-opacity-10 rounded p-2 flex-shrink-0">
                        <i class="bi bi-envelope-fill text-danger"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium small">Judge Requests</div>
                        <div class="text-muted" style="font-size:.72rem;"><%= stats.pendingRequests %> open</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a href="/admin/users" class="list-group-item list-group-item-action px-4 py-3 d-flex align-items-center gap-3 border-0 border-bottom">
                    <div class="bg-primary bg-opacity-10 rounded p-2 flex-shrink-0">
                        <i class="bi bi-people-fill text-primary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium small">User Management</div>
                        <div class="text-muted" style="font-size:.72rem;"><%= stats.users.new_30d %> new this month</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
                <a href="/admin/reports" class="list-group-item list-group-item-action px-4 py-3 d-flex align-items-center gap-3 border-0">
                    <div class="bg-success bg-opacity-10 rounded p-2 flex-shrink-0">
                        <i class="bi bi-graph-up-arrow text-success"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium small">Platform Reports</div>
                        <div class="text-muted" style="font-size:.72rem;">Activity & growth stats</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>
            </div>
        </div>
    </div>

</div>

<!-- ── Recent Users + Recent Events ───────────────────────────────────────── -->
<div class="row g-4">

    <!-- Recent users -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-semibold py-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people text-danger me-2"></i>Recent Registrations</span>
                <a href="/admin/users" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <% if (stats.recentUsers.length === 0) { %>
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-people fs-2 d-block mb-2 opacity-25"></i>
                    <small>No users yet.</small>
                </div>
            <% } else { %>
                <ul class="list-group list-group-flush">
                    <% stats.recentUsers.forEach(u => { %>
                        <li class="list-group-item px-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-secondary bg-opacity-10
                                            d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:36px;height:36px; font-size:.75rem; font-weight:700; color:#6c757d;">
                                    <%= (u.first_name[0] + u.last_name[0]).toUpperCase() %>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold small text-truncate">
                                        <%= u.first_name %> <%= u.last_name %>
                                    </div>
                                    <div class="text-muted text-truncate" style="font-size:.72rem;">
                                        <%= u.email %>
                                    </div>
                                </div>
                                <div class="text-end flex-shrink-0">
                                    <span class="badge <%= ROLE_BADGE[u.role_name] || 'bg-secondary' %> fw-normal small mb-1 d-block">
                                        <%= u.role_label %>
                                    </span>
                                    <span class="text-muted" style="font-size:.7rem;">
                                        <%= fmtRelative(u.created_at) %>
                                    </span>
                                </div>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    </div>

    <!-- Recent events -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-semibold py-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar3 text-danger me-2"></i>Recent Events</span>
                <a href="/events" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <% if (stats.recentEvents.length === 0) { %>
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-calendar-x fs-2 d-block mb-2 opacity-25"></i>
                    <small>No events yet.</small>
                </div>
            <% } else { %>
                <ul class="list-group list-group-flush">
                    <% stats.recentEvents.forEach(ev => { %>
                        <li class="list-group-item px-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="text-center flex-shrink-0" style="width:36px;">
                                    <% const evDate = new Date(ev.start_datetime); %>
                                    <div class="fw-bold text-danger lh-1" style="font-size:.85rem;">
                                        <%= evDate.getDate() %>
                                    </div>
                                    <div class="text-muted text-uppercase lh-1" style="font-size:.6rem;">
                                        <%= evDate.toLocaleString('en-US', { month:'short' }) %>
                                    </div>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold small text-truncate"><%= ev.title %></div>
                                    <div class="text-muted text-truncate" style="font-size:.72rem;">
                                        <%= ev.school_name || 'Platform event' %> ·
                                        <span class="text-capitalize"><%= (ev.event_type || '').replace('_',' ') %></span>
                                    </div>
                                </div>
                                <span class="badge <%= STATUS_BADGE[ev.status] || 'bg-secondary' %> fw-normal flex-shrink-0">
                                    <%= ev.status %>
                                </span>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    </div>

</div>
