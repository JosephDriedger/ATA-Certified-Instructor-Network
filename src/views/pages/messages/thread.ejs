<%
    const fmtTime = (d) =>
        new Date(d).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

    const fmtDate = (d) =>
        new Date(d).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
%>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a href="/messages" class="text-decoration-none">Messages</a>
        </li>
        <li class="breadcrumb-item active">
            <%= conversation.other_first %> <%= conversation.other_last %>
        </li>
    </ol>
</nav>

<!-- Thread header -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3 px-4 d-flex align-items-center gap-3">

        <% if (conversation.other_photo) { %>
            <img src="<%= conversation.other_photo %>"
                 alt="<%= conversation.other_first %>"
                 class="rounded-circle flex-shrink-0"
                 width="44" height="44"
                 style="object-fit:cover;">
        <% } else { %>
            <div class="rounded-circle bg-secondary bg-opacity-15 d-flex align-items-center
                        justify-content-center flex-shrink-0"
                 style="width:44px;height:44px;">
                <i class="bi bi-person-fill text-secondary fs-5"></i>
            </div>
        <% } %>

        <div class="flex-grow-1 overflow-hidden">
            <div class="fw-bold text-truncate">
                <%= conversation.other_first %> <%= conversation.other_last %>
            </div>
            <% if (conversation.subject) { %>
                <div class="small text-muted text-truncate"><%= conversation.subject %></div>
            <% } %>
        </div>

        <a href="/messages/compose?userId=<%= conversation.other_id %>"
           class="btn btn-sm btn-outline-secondary flex-shrink-0" title="New conversation">
            <i class="bi bi-pencil-square"></i>
        </a>

    </div>
</div>

<!-- Message thread -->
<div class="d-flex flex-column gap-1 mb-4" id="threadMessages">

    <% if (messages.length === 0) { %>
        <div class="text-center text-muted py-5">
            <i class="bi bi-chat fs-1 d-block mb-2 opacity-25"></i>
            <small>No messages yet. Send the first one below.</small>
        </div>
    <% } %>

    <%
        let lastDateStr = null;
    %>

    <% messages.forEach(msg => { %>
        <%
            const isMine   = msg.sender_id === userId;
            const dateStr  = fmtDate(msg.created_at);
            const showDate = dateStr !== lastDateStr;
            lastDateStr    = dateStr;
        %>

        <!-- Date separator -->
        <% if (showDate) { %>
            <div class="text-center my-3">
                <span class="badge bg-light text-muted border fw-normal px-3 py-1"
                      style="font-size:.72rem;">
                    <%= dateStr %>
                </span>
            </div>
        <% } %>

        <!-- Message bubble -->
        <div class="d-flex gap-2 mb-1 <%= isMine ? 'flex-row-reverse' : '' %>">

            <!-- Avatar -->
            <div class="flex-shrink-0 align-self-end mb-1">
                <% if (msg.sender_photo) { %>
                    <img src="<%= msg.sender_photo %>"
                         alt="<%= msg.sender_first_name %>"
                         class="rounded-circle"
                         width="32" height="32"
                         style="object-fit:cover;">
                <% } else { %>
                    <div class="rounded-circle bg-secondary bg-opacity-15 d-flex align-items-center
                                justify-content-center"
                         style="width:32px;height:32px;">
                        <i class="bi bi-person-fill text-secondary" style="font-size:.85rem;"></i>
                    </div>
                <% } %>
            </div>

            <!-- Bubble + meta -->
            <div class="<%= isMine ? 'text-end' : '' %>" style="max-width:72%;">
                <div class="<%= isMine
                    ? 'bg-dark text-white'
                    : 'bg-light border' %>
                    rounded-3 px-3 py-2 mb-1 d-inline-block text-start"
                     style="word-break:break-word; white-space:pre-wrap; line-height:1.5;">
                    <%= msg.body %>
                </div>
                <div class="text-muted d-block" style="font-size:.7rem;">
                    <%= fmtTime(msg.created_at) %>
                    <% if (isMine && msg.is_read) { %>
                        <i class="bi bi-check2-all text-primary ms-1" title="Read"></i>
                    <% } else if (isMine) { %>
                        <i class="bi bi-check2 text-muted ms-1" title="Delivered"></i>
                    <% } %>
                </div>
            </div>

        </div>

    <% }) %>

    <!-- Anchor for scroll-to-bottom -->
    <div id="bottom"></div>
</div>

<!-- Reply form -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="POST" action="/messages/<%= conversation.id %>/reply" id="replyForm">

            <% if (flash && flash.type === 'error') { %>
                <div class="alert alert-danger py-2 small mb-2">
                    <%= flash.message %>
                </div>
            <% } %>

            <div class="d-flex gap-2 align-items-end">
                <textarea
                    id="replyBody"
                    name="body"
                    class="form-control flex-grow-1"
                    rows="2"
                    placeholder="Type a message…"
                    maxlength="5000"
                    required
                    style="resize:none;"></textarea>
                <button type="submit" class="btn btn-danger px-3 flex-shrink-0" style="height:72px;">
                    <i class="bi bi-send-fill d-block mb-1"></i>
                    <small>Send</small>
                </button>
            </div>

            <div class="d-flex justify-content-between mt-1">
                <div class="form-text">Press Ctrl+Enter to send.</div>
                <div class="form-text" id="charCount">0 / 5,000</div>
            </div>

        </form>
    </div>
</div>

<script>
// ── Scroll to latest message on load ─────────────────────────────────────
document.getElementById('bottom')?.scrollIntoView({ behavior: 'instant' });

// ── Character counter ─────────────────────────────────────────────────────
const replyBody = document.getElementById('replyBody');
const charCount = document.getElementById('charCount');
replyBody.addEventListener('input', () => {
    charCount.textContent = `${replyBody.value.length.toLocaleString()} / 5,000`;
    charCount.style.color = replyBody.value.length > 4500 ? '#dc3545' : '';
});

// ── Ctrl+Enter to submit ──────────────────────────────────────────────────
replyBody.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        document.getElementById('replyForm').requestSubmit();
    }
});

// ── Auto-grow textarea ────────────────────────────────────────────────────
replyBody.addEventListener('input', () => {
    replyBody.style.height = 'auto';
    replyBody.style.height = Math.min(replyBody.scrollHeight, 200) + 'px';
});
</script>
