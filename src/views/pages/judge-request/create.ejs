<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1">Send Judge Request</h2>
        <p class="text-muted small mb-0">
            Requesting on behalf of <strong><%= school.name %></strong>
        </p>
    </div>
    <a href="/instructors" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Instructors
    </a>
</div>

<div class="row g-4">

    <!-- Instructor card (left) -->
    <div class="col-lg-4 order-lg-2">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-semibold py-3">
                <i class="bi bi-person-badge text-danger me-2"></i>Requesting
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <% if (instructor.profile_photo_url) { %>
                        <img src="<%= instructor.profile_photo_url %>"
                             alt="<%= instructor.first_name %>"
                             class="rounded-circle flex-shrink-0"
                             width="56" height="56"
                             style="object-fit:cover;">
                    <% } else { %>
                        <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:56px;height:56px;">
                            <i class="bi bi-person-fill text-secondary fs-3"></i>
                        </div>
                    <% } %>
                    <div>
                        <div class="fw-bold">
                            <%= instructor.first_name %> <%= instructor.last_name %>
                        </div>
                        <% if (instructor.rank) { %>
                            <small class="text-muted"><%= instructor.rank %></small>
                        <% } %>
                    </div>
                </div>

                <% if (instructor.certification_level) { %>
                    <div class="mb-2">
                        <span class="badge bg-danger bg-opacity-10 text-danger fw-normal small">
                            <%= instructor.certification_level %>
                        </span>
                    </div>
                <% } %>

                <% if (instructor.city || instructor.state) { %>
                    <p class="small text-muted mb-1">
                        <i class="bi bi-geo-alt me-1"></i>
                        <%= [instructor.city, instructor.state].filter(Boolean).join(', ') %>
                    </p>
                <% } %>

                <% if (instructor.travel_radius_miles) { %>
                    <p class="small text-muted mb-0">
                        <i class="bi bi-car-front me-1"></i>
                        Travels up to <%= instructor.travel_radius_miles %> miles
                    </p>
                <% } %>

                <!-- Availability badges -->
                <div class="d-flex flex-wrap gap-1 mt-3">
                    <% if (instructor.is_available_for_events) { %>
                        <span class="badge bg-success bg-opacity-10 text-success fw-normal small">Events</span>
                    <% } %>
                    <% if (instructor.is_available_for_testing) { %>
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-normal small">Testing</span>
                    <% } %>
                    <% if (instructor.is_available_for_seminars) { %>
                        <span class="badge bg-warning bg-opacity-10 text-warning fw-normal small">Seminars</span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Request form (right) -->
    <div class="col-lg-8 order-lg-1">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom fw-semibold py-3">
                <i class="bi bi-envelope text-danger me-2"></i>Request Details
            </div>
            <div class="card-body p-4">

                <% if (errors.requestedDate && errors.requestedDate.includes('pending')) { %>
                    <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-4">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                        <span><%= errors.requestedDate %></span>
                    </div>
                <% } %>

                <% if (ownedSchools && ownedSchools.length > 1) { %>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Requesting on behalf of</label>
                        <div class="d-flex flex-wrap gap-2">
                            <% ownedSchools.forEach(s => { %>
                                <a href="/judge-requests/create?instructorId=<%= instructor.id %>&school=<%= s.id %>"
                                   class="btn btn-sm <%= s.id === school.id ? 'btn-dark' : 'btn-outline-secondary' %>">
                                    <%= s.name %>
                                </a>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <form action="/judge-requests" method="POST" novalidate>

                    <!-- Hidden fields -->
                    <input type="hidden" name="instructorId" value="<%= instructor.id %>">
                    <input type="hidden" name="schoolId"     value="<%= school.id %>">

                    <!-- Link to event (optional) -->
                    <div class="mb-3">
                        <label for="eventId" class="form-label fw-medium">
                            Link to Event <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <select id="eventId" name="eventId" class="form-select">
                            <option value="">— No specific event —</option>
                            <% schoolEvents.forEach(ev => { %>
                                <option value="<%= ev.id %>"
                                        <%= (formData.eventId == ev.id) ? 'selected' : '' %>>
                                    <%= ev.title %> —
                                    <%= new Date(ev.start_datetime).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (!schoolEvents.length) { %>
                            <div class="form-text">
                                No events posted yet.
                                <a href="/events/create" class="text-decoration-none">Create one first?</a>
                            </div>
                        <% } %>
                    </div>

                    <!-- Date & Time row -->
                    <div class="row g-3 mb-3">
                        <div class="col-sm-7">
                            <label for="requestedDate" class="form-label fw-medium">
                                Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="requestedDate" name="requestedDate"
                                   class="form-control <%= errors.requestedDate ? 'is-invalid' : '' %>"
                                   value="<%= formData.requestedDate || '' %>"
                                   min="<%= new Date().toISOString().split('T')[0] %>"
                                   required>
                            <% if (errors.requestedDate) { %>
                                <div class="invalid-feedback"><%= errors.requestedDate %></div>
                            <% } %>
                        </div>
                        <div class="col-sm-5">
                            <label for="requestedTime" class="form-label fw-medium">
                                Start Time
                            </label>
                            <input type="time" id="requestedTime" name="requestedTime"
                                   class="form-control"
                                   value="<%= formData.requestedTime || '' %>">
                            <div class="form-text">When judging begins.</div>
                        </div>
                    </div>

                    <!-- Location override -->
                    <div class="mb-3">
                        <label for="locationName" class="form-label fw-medium">
                            Location <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input type="text" id="locationName" name="locationName"
                               class="form-control"
                               value="<%= formData.locationName || '' %>"
                               placeholder="Venue name or address — leave blank to use the linked event's location"
                               maxlength="255">
                    </div>

                    <!-- Required rank & Judges needed -->
                    <div class="row g-3 mb-3">
                        <div class="col-sm-7">
                            <label for="requiredRank" class="form-label fw-medium">
                                Minimum Rank Required
                            </label>
                            <select id="requiredRank" name="requiredRank" class="form-select">
                                <option value="">No minimum requirement</option>
                                <% RANKS.forEach(r => { %>
                                    <option value="<%= r %>"
                                            <%= formData.requiredRank === r ? 'selected' : '' %>><%= r %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label for="judgesNeeded" class="form-label fw-medium">
                                Judges Needed
                            </label>
                            <input type="number" id="judgesNeeded" name="judgesNeeded"
                                   class="form-control"
                                   value="<%= formData.judgesNeeded || 1 %>"
                                   min="1" max="20">
                            <div class="form-text">Total for this event.</div>
                        </div>
                    </div>

                    <!-- Message -->
                    <div class="mb-4">
                        <label for="message" class="form-label fw-medium">Message</label>
                        <textarea id="message" name="message" rows="5"
                                  class="form-control <%= errors.message ? 'is-invalid' : '' %>"
                                  maxlength="1000"
                                  placeholder="Introduce yourself, describe the event, mention any compensation or travel arrangements, and anything the instructor should know…"><%= formData.message || '' %></textarea>
                        <% if (errors.message) { %>
                            <div class="invalid-feedback"><%= errors.message %></div>
                        <% } %>
                        <div class="form-text text-end">
                            <span id="msgCount">0</span> / 1,000 characters
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/instructors/<%= instructor.id %>" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold">
                            <i class="bi bi-send me-1"></i>Send Request
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

</div>

<script>
const msgEl   = document.getElementById('message');
const cntEl   = document.getElementById('msgCount');
const update  = () => { cntEl.textContent = msgEl.value.length; };
msgEl.addEventListener('input', update);
update();
</script>
