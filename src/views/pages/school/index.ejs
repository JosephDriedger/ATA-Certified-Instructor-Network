<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">School Directory</h2>
        <p class="text-muted small mb-0">
            <% if (total > 0) { %>
                <%= schools.length %> of <%= total %> ATA school<%= total !== 1 ? 's' : '' %>
            <% } else { %>
                No schools found
            <% } %>
        </p>
    </div>
    <% if (user && user.roleId === 2) { %>
        <a href="/schools/manage" class="btn btn-danger btn-sm">
            <i class="bi bi-gear me-1"></i>Manage My School
        </a>
    <% } %>
</div>

<!-- Search -->
<form method="GET" action="/schools" class="row g-2 mb-4">
    <div class="col-sm-7 col-md-5">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" name="search" class="form-control border-start-0 ps-0"
                   placeholder="Search by school name or city…"
                   value="<%= search %>" maxlength="100">
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-danger px-3">Search</button>
        <% if (search) { %>
            <a href="/schools" class="btn btn-outline-secondary ms-1">Clear</a>
        <% } %>
    </div>
</form>

<!-- Grid -->
<% if (schools.length === 0) { %>
    <div class="text-center py-5 text-muted">
        <i class="bi bi-building fs-1 d-block mb-3 opacity-25"></i>
        <p class="mb-0">No schools match your search.</p>
        <% if (search) { %>
            <a href="/schools" class="btn btn-sm btn-outline-secondary mt-3">Clear search</a>
        <% } %>
    </div>
<% } else { %>
    <div class="row g-4 mb-4">
        <% schools.forEach(school => { %>
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <%- include('../../partials/school-card', { school }) %>
            </div>
        <% }) %>
    </div>
<% } %>

<!-- Pagination -->
<% if (totalPages > 1) { %>
    <nav aria-label="School directory pages">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            <% for (let p = 1; p <= totalPages; p++) { %>
                <% if (p === 1 || p === totalPages || Math.abs(p - page) <= 2) { %>
                    <li class="page-item <%= p === page ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= p %>&search=<%= encodeURIComponent(search) %>"><%= p %></a>
                    </li>
                <% } else if (Math.abs(p - page) === 3) { %>
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                <% } %>
            <% } %>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
<% } %>
