<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1">My Schools</h2>
        <p class="text-muted small mb-0">
            <%= schools.length %> school<%= schools.length !== 1 ? 's' : '' %>
        </p>
    </div>
    <a href="/schools/mine/new" class="btn btn-danger">
        <i class="bi bi-plus-lg me-1"></i>Add School
    </a>
</div>

<% if (schools.length === 0) { %>

    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 px-4">
            <i class="bi bi-building-add text-muted fs-1 d-block mb-3 opacity-25"></i>
            <h5 class="fw-bold mb-2">Create Your First School</h5>
            <p class="text-muted mb-4 mx-auto" style="max-width:420px;">
                Set up a school profile to post events, manage your instructor roster,
                and send guest judge requests.
            </p>
            <a href="/schools/mine/new" class="btn btn-danger px-4 fw-semibold">
                Create School
            </a>
        </div>
    </div>

<% } else { %>

    <div class="row g-4">
        <% schools.forEach(school => { %>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">

                        <!-- Logo + name -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <% if (school.logo_url) { %>
                                <img src="<%= school.logo_url %>"
                                     alt="<%= school.name %>"
                                     class="rounded flex-shrink-0"
                                     width="56" height="56"
                                     style="object-fit:contain; background:#f8f9fa; padding:4px;">
                            <% } else { %>
                                <div class="rounded bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:56px;height:56px;">
                                    <i class="bi bi-building text-danger fs-4"></i>
                                </div>
                            <% } %>
                            <div class="overflow-hidden">
                                <h6 class="fw-bold mb-0 text-truncate"><%= school.name %></h6>
                                <% if (school.city || school.state) { %>
                                    <small class="text-muted">
                                        <%= [school.city, school.state].filter(Boolean).join(', ') %>
                                    </small>
                                <% } %>
                            </div>
                            <span class="ms-auto badge <%= school.is_active ? 'bg-success' : 'bg-secondary' %> fw-normal flex-shrink-0">
                                <%= school.is_active ? 'Active' : 'Inactive' %>
                            </span>
                        </div>

                        <!-- Quick stats -->
                        <div class="d-flex gap-3 small text-muted mb-3">
                            <% if (school.phone) { %>
                                <span><i class="bi bi-telephone me-1"></i><%= school.phone %></span>
                            <% } %>
                            <% if (school.email) { %>
                                <span><i class="bi bi-envelope me-1"></i><%= school.email %></span>
                            <% } %>
                        </div>

                    </div>
                    <div class="card-footer bg-white border-top d-flex gap-2 flex-wrap">
                        <a href="/schools/mine/<%= school.id %>/manage"
                           class="btn btn-sm btn-danger flex-fill">
                            <i class="bi bi-gear me-1"></i>Manage
                        </a>
                        <a href="/schools/mine/<%= school.id %>/edit"
                           class="btn btn-sm btn-outline-secondary flex-fill">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a href="/schools/<%= school.slug %>"
                           class="btn btn-sm btn-outline-secondary flex-shrink-0"
                           target="_blank" title="View public page">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>

        <!-- Add another school card -->
        <div class="col-lg-6">
            <a href="/schools/mine/new" class="text-decoration-none">
                <div class="card border-2 border-dashed border-secondary h-100"
                     style="border-style:dashed !important; min-height:160px;">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-muted p-4">
                        <i class="bi bi-plus-circle fs-2 mb-2 text-danger opacity-75"></i>
                        <span class="fw-semibold">Add Another School</span>
                        <small class="mt-1">Manage multiple locations</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

<% } %>
