<%
    // ── Helpers ───────────────────────────────────────────────────────────────

    const fmtDate = (d) => d
        ? new Date(d).toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric', year:'numeric' })
        : 'Date TBD';

    const fmtTime = (t) => {
        if (!t) return '';
        const [h, m] = String(t).split(':');
        const hour = parseInt(h, 10);
        return `${hour % 12 || 12}:${m} ${hour < 12 ? 'AM' : 'PM'}`;
    };

    const pct  = (n) => Math.round(Math.max(0, Math.min(100, n)));
    const barColor = (score) =>
        score >= 80 ? 'bg-success' :
        score >= 60 ? 'bg-primary' :
        score >= 40 ? 'bg-warning' : 'bg-secondary';

    const SIGNAL_LABELS = {
        rank:          { label: 'Rank',          icon: 'bi-award-fill'       },
        availability:  { label: 'Availability',  icon: 'bi-calendar-check'   },
        distance:      { label: 'Distance',      icon: 'bi-geo-alt-fill'     },
        certification: { label: 'Certification', icon: 'bi-patch-check-fill' },
        history:       { label: 'History',       icon: 'bi-clock-history'    }
    };

    const EVENT_TYPE_LABEL = {
        belt_testing: 'Belt Testing',
        tournament:   'Tournament',
        seminar:      'Seminar',
        camp:         'Camp',
        other:        'Event'
    };
%>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/schools/mine/<%= school.id %>/manage" class="text-decoration-none">School</a></li>
        <li class="breadcrumb-item active">Judge Recommendations</li>
    </ol>
</nav>

<!-- Event summary header -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="bg-danger bg-opacity-10 rounded-3 p-2 flex-shrink-0">
                        <i class="bi bi-award-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold mb-0"><%= event.title %></h2>
                        <span class="badge bg-light text-dark border fw-normal text-capitalize">
                            <%= EVENT_TYPE_LABEL[event.event_type] || event.event_type %>
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3 small text-muted">
                    <span><i class="bi bi-calendar3 me-1"></i><%= fmtDate(event.start_datetime) %></span>
                    <% if (event.city || event.state) { %>
                        <span>
                            <i class="bi bi-geo-alt me-1"></i>
                            <%= [event.location_name, event.city, event.state].filter(Boolean).join(', ') %>
                        </span>
                    <% } %>
                    <% if (school) { %>
                        <span><i class="bi bi-building me-1"></i><%= school.name %></span>
                    <% } %>
                </div>
            </div>

            <div class="col-lg-4 text-lg-end">
                <div class="text-muted small mb-1">
                    <strong><%= recommendations.length %></strong> recommendations
                    <% if (totalCandidates > recommendations.length) { %>
                        from <%= totalCandidates %> eligible instructors
                    <% } %>
                </div>
                <% if (meta.minRankLabel) { %>
                    <div class="text-muted small">
                        Recommended min. rank: <strong><%= meta.minRankLabel %></strong>
                    </div>
                <% } %>
                <a href="/events/create" class="btn btn-sm btn-outline-secondary mt-2">
                    <i class="bi bi-calendar-plus me-1"></i>New Event
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Scoring method explanation -->
<div class="card border-0 bg-light border-start border-4 border-danger mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-start gap-3 flex-wrap">
            <i class="bi bi-info-circle-fill text-danger mt-1 flex-shrink-0"></i>
            <div class="small text-muted">
                <strong class="text-dark">How scores are calculated:</strong>
                Instructors are ranked using five weighted signals —
                <strong>Rank</strong> (<%= Math.round(meta.weights.rank * 100) %>%),
                <strong>Availability</strong> (<%= Math.round(meta.weights.availability * 100) %>%),
                <strong>Distance</strong> (<%= Math.round(meta.weights.distance * 100) %>%),
                <strong>Certification</strong> (<%= Math.round(meta.weights.certification * 100) %>%), and
                <strong>Judging History</strong> (<%= Math.round(meta.weights.history * 100) %>%).
                Instructors already booked or explicitly unavailable on this date are excluded automatically.
            </div>
        </div>
    </div>
</div>

<!-- ── From Your Roster ──────────────────────────────────────────────────── -->
<% if (roster && roster.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold">
                <i class="bi bi-people text-danger me-2"></i>From Your Roster
                <span class="badge bg-secondary ms-1 fw-normal"><%= roster.length %></span>
            </span>
            <a href="/schools/mine/<%= school.id %>/manage?tab=roster"
               class="btn btn-sm btn-outline-secondary">Manage Roster</a>
        </div>
        <ul class="list-group list-group-flush">
            <% roster.forEach(member => { %>
                <li class="list-group-item px-4 py-3">
                    <div class="d-flex align-items-center gap-3">

                        <!-- Avatar -->
                        <% if (member.profile_photo_url) { %>
                            <img src="<%= member.profile_photo_url %>"
                                 class="rounded-circle flex-shrink-0"
                                 width="44" height="44" style="object-fit:cover;">
                        <% } else { %>
                            <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:44px;height:44px;">
                                <i class="bi bi-person-fill text-secondary fs-5"></i>
                            </div>
                        <% } %>

                        <!-- Name + rank + role -->
                        <div class="flex-grow-1">
                            <div class="fw-semibold">
                                <%= member.first_name %> <%= member.last_name %>
                            </div>
                            <div class="small text-muted">
                                <%= [member.role_title, member.rank].filter(Boolean).join(' · ') %>
                            </div>
                        </div>

                        <!-- Status + action -->
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <% if (member.alreadyBooked) { %>
                                <span class="badge bg-danger fw-normal">Already Booked</span>
                            <% } else if (member.alreadySent) { %>
                                <span class="badge bg-warning text-dark fw-normal">Request Sent</span>
                                <a href="/bookings" class="btn btn-sm btn-outline-secondary">View</a>
                            <% } else { %>
                                <a href="/judge-requests/create?instructorId=<%= member.instructor_id %>&school=<%= school.id %>&eventId=<%= event.id %>"
                                   class="btn btn-sm btn-danger">
                                    <i class="bi bi-send me-1"></i>Send Request
                                </a>
                            <% } %>
                            <a href="/instructors/<%= member.instructor_id %>"
                               class="btn btn-sm btn-outline-secondary">Profile</a>
                        </div>

                    </div>
                </li>
            <% }) %>
        </ul>
    </div>
<% } %>

<!-- ── Scored Recommendations ─────────────────────────────────────────────── -->
<% if (recommendations.length > 0) { %>
    <h6 class="fw-semibold text-muted text-uppercase mb-3" style="font-size:.75rem; letter-spacing:.05em;">
        <i class="bi bi-stars me-1 text-danger"></i>All Recommended Instructors
    </h6>
<% } %>

<!-- Empty state -->
<% if (recommendations.length === 0) { %>
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-person-slash fs-1 text-muted d-block mb-3 opacity-25"></i>
            <h5 class="fw-bold mb-2">No eligible instructors found</h5>
            <p class="text-muted mb-4 mx-auto" style="max-width:440px;">
                All instructors matching your event date are either unavailable, already booked,
                or affiliated with your school. Try adjusting the event date or
                <a href="/instructors" class="text-decoration-none">browse the full directory</a>.
            </p>
            <a href="/instructors" class="btn btn-danger">Browse All Instructors</a>
        </div>
    </div>
<% } else { %>

<!-- Recommendation list -->
<div class="d-flex flex-column gap-4">
    <% recommendations.forEach((rec, index) => { %>
        <%
            const score     = rec.score;
            const bColor    = barColor(score.total);
            const tier      = rec.tier;
            const collapseId = `scoreDetails-${index}`;
        %>
        <div class="card border-0 shadow-sm <%= index === 0 ? 'border-2 border-success' : '' %>">
            <div class="card-body p-4">
                <div class="row g-4 align-items-center">

                    <!-- Rank badge (position) -->
                    <div class="col-auto d-none d-md-block">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold
                                    <%= index === 0 ? 'bg-success text-white' : index === 1 ? 'bg-primary text-white' : index === 2 ? 'bg-danger text-white' : 'bg-light text-muted' %>"
                             style="width:44px;height:44px;font-size:.9rem;">
                            #<%= rec.position %>
                        </div>
                    </div>

                    <!-- Photo + Identity -->
                    <div class="col-sm-auto">
                        <% if (rec.profile_photo_url) { %>
                            <img src="<%= rec.profile_photo_url %>"
                                 alt="<%= rec.first_name %>"
                                 class="rounded-circle"
                                 width="72" height="72"
                                 style="object-fit:cover;">
                        <% } else { %>
                            <div class="rounded-circle bg-secondary bg-opacity-10
                                        d-flex align-items-center justify-content-center"
                                 style="width:72px;height:72px;">
                                <i class="bi bi-person-fill text-secondary" style="font-size:2rem;"></i>
                            </div>
                        <% } %>
                    </div>

                    <!-- Info -->
                    <div class="col">
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h5 class="fw-bold mb-0">
                                <%= rec.first_name %> <%= rec.last_name %>
                            </h5>
                            <span class="badge bg-<%= tier.color %> fw-normal">
                                <i class="bi <%= tier.icon %> me-1"></i><%= tier.label %>
                            </span>
                            <% if (index === 0) { %>
                                <span class="badge bg-success fw-normal">Top Pick</span>
                            <% } %>
                        </div>

                        <div class="d-flex flex-wrap gap-2 small text-muted mb-2">
                            <% if (rec.rank) { %>
                                <span><i class="bi bi-award me-1"></i><%= rec.rank %></span>
                            <% } %>
                            <% if (rec.certification_level) { %>
                                <span><i class="bi bi-patch-check me-1"></i><%= rec.certification_level %></span>
                            <% } %>
                            <% if (rec.instructor_city || rec.instructor_state) { %>
                                <span>
                                    <i class="bi bi-geo-alt me-1"></i>
                                    <%= [rec.instructor_city, rec.instructor_state].filter(Boolean).join(', ') %>
                                </span>
                            <% } %>
                            <% if (rec.school_name) { %>
                                <span><i class="bi bi-building me-1"></i><%= rec.school_name %></span>
                            <% } %>
                            <% if (rec.judging_total > 0) { %>
                                <span>
                                    <i class="bi bi-trophy me-1"></i>
                                    <%= rec.judging_total %> completed
                                    <% if (rec.judging_type_match > 0) { %>
                                        (<%= rec.judging_type_match %> <%= (EVENT_TYPE_LABEL[event.event_type] || 'this type').toLowerCase() %>)
                                    <% } %>
                                </span>
                            <% } %>
                            <% if (rec.travel_radius_miles) { %>
                                <span>
                                    <i class="bi bi-car-front me-1"></i>
                                    Travels up to <%= rec.travel_radius_miles %> mi
                                </span>
                            <% } %>
                        </div>

                        <!-- Specialties -->
                        <% if (rec.specialties.length > 0) { %>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <% rec.specialties.slice(0, 4).forEach(s => { %>
                                    <span class="badge bg-light text-dark border fw-normal"
                                          style="font-size:.65rem;"><%= s %></span>
                                <% }) %>
                                <% if (rec.specialties.length > 4) { %>
                                    <span class="badge bg-light text-muted border fw-normal"
                                          style="font-size:.65rem;">
                                        +<%= rec.specialties.length - 4 %>
                                    </span>
                                <% } %>
                            </div>
                        <% } %>

                        <!-- Availability indicator -->
                        <div class="small">
                            <% if (rec.explicit_availability === 1) { %>
                                <span class="text-success fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Explicitly available
                                    <% if (rec.avail_start) { %>
                                        from <%= fmtTime(rec.avail_start) %>
                                        <% if (rec.avail_end) { %> – <%= fmtTime(rec.avail_end) %><% } %>
                                    <% } %>
                                </span>
                            <% } else if (rec.explicit_availability === null) { %>
                                <span class="text-muted">
                                    <i class="bi bi-circle me-1"></i>
                                    Available by default
                                    <% if (event.event_type === 'belt_testing' && rec.is_available_for_testing) { %>
                                        · <span class="text-primary">Marked available for testing</span>
                                    <% } else if (rec.is_available_for_events) { %>
                                        · <span class="text-primary">Open for events</span>
                                    <% } %>
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Score + Actions -->
                    <div class="col-md-auto text-center">
                        <!-- Score ring -->
                        <div class="mb-2">
                            <div class="display-6 fw-bold <%= score.total >= 80 ? 'text-success' : score.total >= 60 ? 'text-primary' : score.total >= 40 ? 'text-warning' : 'text-secondary' %>">
                                <%= score.total %>
                            </div>
                            <div class="text-muted" style="font-size:.7rem;">/ 100</div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex flex-column gap-2">
                            <a href="/judge-requests/create?instructorId=<%= rec.id %>"
                               class="btn btn-danger btn-sm px-3">
                                <i class="bi bi-send me-1"></i>Send Request
                            </a>
                            <a href="/instructors/<%= rec.id %>"
                               class="btn btn-outline-secondary btn-sm px-3"
                               target="_blank">
                                <i class="bi bi-person me-1"></i>Profile
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Score breakdown (collapsible) -->
                <div class="mt-3 pt-3 border-top">
                    <button class="btn btn-link btn-sm text-muted text-decoration-none p-0"
                            data-bs-toggle="collapse"
                            data-bs-target="#<%= collapseId %>">
                        <i class="bi bi-bar-chart me-1"></i>
                        Score Breakdown
                        <i class="bi bi-chevron-down ms-1 small"></i>
                    </button>

                    <div id="<%= collapseId %>" class="collapse">
                        <div class="row g-2 mt-2">
                            <% Object.entries(score.breakdown).forEach(([signal, sigScore]) => { %>
                                <% const meta2 = SIGNAL_LABELS[signal] || { label: signal, icon: 'bi-circle' }; %>
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi <%= meta2.icon %> text-muted flex-shrink-0" style="width:16px;"></i>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span class="text-muted"><%= meta2.label %></span>
                                                <span class="fw-bold"><%= pct(sigScore) %></span>
                                            </div>
                                            <div class="progress" style="height:5px;">
                                                <div class="progress-bar <%= barColor(sigScore) %>"
                                                     role="progressbar"
                                                     style="width:<%= pct(sigScore) %>%;"></div>
                                            </div>
                                        </div>
                                        <div class="text-muted flex-shrink-0 small"
                                             style="width:30px;text-align:right;">
                                            <%= Math.round(score.weights[signal] * 100) %>%
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    <% }) %>
</div>

<!-- Bottom actions -->
<div class="d-flex justify-content-center gap-3 mt-4">
    <a href="/instructors?date=<%= event.start_datetime ? new Date(event.start_datetime).toISOString().split('T')[0] : '' %>&state=<%= encodeURIComponent(event.state || '') %>"
       class="btn btn-outline-danger">
        <i class="bi bi-search me-1"></i>Browse All Available Instructors
    </a>
    <a href="/schools/mine/<%= school.id %>/manage" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to School
    </a>
</div>

<% } %>
