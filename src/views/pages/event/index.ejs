<%
    const fmtDate = (d) => d
        ? new Date(d).toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric', year:'numeric' })
        : '—';

    const TYPE_ICON = {
        tournament:   'bi-trophy-fill',
        seminar:      'bi-mortarboard-fill',
        belt_testing: 'bi-award-fill',
        camp:         'bi-tree-fill',
        other:        'bi-calendar-event-fill'
    };
    const TYPE_COLOR = {
        tournament:   'text-warning',
        seminar:      'text-primary',
        belt_testing: 'text-danger',
        camp:         'text-success',
        other:        'text-secondary'
    };
%>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Events</h2>
        <p class="text-muted small mb-0">
            <% if (total > 0) { %>
                <%= events.length %> of <%= total %> upcoming event<%= total !== 1 ? 's' : '' %>
            <% } else { %>
                No upcoming events
            <% } %>
        </p>
    </div>
    <% if (user && user.roleId === 2) { %>
        <a href="/events/create" class="btn btn-danger btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Post Event
        </a>
    <% } %>
</div>

<!-- Type filter tabs -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/events"
       class="btn btn-sm <%= !selectedType ? 'btn-dark' : 'btn-outline-secondary' %>">
        All Events
    </a>
    <% EVENT_TYPES.forEach(t => { %>
        <a href="/events?type=<%= t.value %>"
           class="btn btn-sm <%= selectedType === t.value ? 'btn-dark' : 'btn-outline-secondary' %>">
            <i class="bi <%= TYPE_ICON[t.value] %> me-1"></i><%= t.label %>
        </a>
    <% }) %>
</div>

<!-- Event grid -->
<% if (events.length === 0) { %>
    <div class="text-center py-5 text-muted">
        <i class="bi bi-calendar-x fs-1 d-block mb-3 opacity-25"></i>
        <p class="mb-2">No upcoming events
            <% if (selectedType) { %>of this type<% } %>.
        </p>
        <% if (selectedType) { %>
            <a href="/events" class="btn btn-sm btn-outline-secondary">View all events</a>
        <% } %>
    </div>
<% } else { %>
    <div class="row g-4 mb-4">
        <% events.forEach(ev => { %>
            <%
                const evStart = new Date(ev.start_datetime);
                const icon    = TYPE_ICON[ev.event_type]  || 'bi-calendar-event-fill';
                const color   = TYPE_COLOR[ev.event_type] || 'text-secondary';
            %>
            <div class="col-sm-6 col-lg-4">
                <a href="/events/<%= ev.id %>" class="text-decoration-none text-reset">
                    <div class="card border-0 shadow-sm h-100 hover-shadow">
                        <div class="card-body p-4">

                            <!-- Type + Date -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-light border text-capitalize fw-normal">
                                    <i class="bi <%= icon %> <%= color %> me-1"></i>
                                    <%= (ev.event_type || 'other').replace('_', ' ') %>
                                </span>
                                <div class="text-center">
                                    <div class="fw-bold text-danger lh-1" style="font-size:1.3rem;">
                                        <%= evStart.getDate() %>
                                    </div>
                                    <div class="text-muted text-uppercase lh-1" style="font-size:.65rem;">
                                        <%= evStart.toLocaleString('en-US', { month:'short' }) %>
                                    </div>
                                </div>
                            </div>

                            <!-- Title -->
                            <h6 class="fw-bold mb-1"><%= ev.title %></h6>

                            <!-- School -->
                            <% if (ev.school_name) { %>
                                <p class="small text-muted mb-2">
                                    <i class="bi bi-building me-1"></i><%= ev.school_name %>
                                </p>
                            <% } %>

                            <!-- Location + Time -->
                            <div class="small text-muted d-flex flex-column gap-1">
                                <% if (ev.city || ev.state) { %>
                                    <span>
                                        <i class="bi bi-geo-alt me-1"></i>
                                        <%= [ev.location_name, ev.city, ev.state].filter(Boolean).join(', ') %>
                                    </span>
                                <% } %>
                                <span>
                                    <i class="bi bi-clock me-1"></i>
                                    <%= evStart.toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit' }) %>
                                    <% if (ev.max_participants) { %>
                                        · Max <%= ev.max_participants %> participants
                                    <% } %>
                                </span>
                            </div>

                        </div>
                        <div class="card-footer bg-white border-top small text-muted">
                            <%= fmtDate(ev.start_datetime) %>
                            <span class="float-end text-danger fw-medium">
                                View details <i class="bi bi-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>
            </div>
        <% }) %>
    </div>
<% } %>

<!-- Pagination -->
<% if (totalPages > 1) { %>
    <nav aria-label="Events pages">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %>&type=<%= selectedType %>">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            <% for (let p = 1; p <= totalPages; p++) { %>
                <li class="page-item <%= p === page ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>&type=<%= selectedType %>"><%= p %></a>
                </li>
            <% } %>
            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %>&type=<%= selectedType %>">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
<% } %>
