# ══════════════════════════════════════════════════════════════════════════════
#  ACIN — ATA Certified Instructor Network
#  Environment Variable Template
#
#  DO NOT put real credentials here — this file IS committed to version control.
#
#  How it works
#  ────────────
#  npm run dev   → loads .env.development   (git-ignored, dev credentials)
#  npm start     → loads .env.production    (git-ignored, prod credentials)
#
#  Setup
#  ─────
#  cp .env.example .env.development
#  cp .env.example .env.production
#  Then fill in the real values in each file.
# ══════════════════════════════════════════════════════════════════════════════


# ── Server ────────────────────────────────────────────────────────────────────

NODE_ENV=development          # development | production
PORT=3000                     # 3000 for dev, 8080 for prod

# Allowed CORS origins — requests from any unlisted origin are rejected.
# Dev:  set DEV_LINK, leave PROD_LINK blank
# Prod: set PROD_LINK, leave DEV_LINK blank
DEV_LINK=http://localhost:3000
PROD_LINK=https://your-domain.com
DEPLOY_LINK=


# ── Database ──────────────────────────────────────────────────────────────────
#
# Use SEPARATE databases and users for each environment.
#
# Development — run once on your local machine:
#
#   mysql -u root -p
#   CREATE DATABASE acin_db_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'acin_dev'@'localhost' IDENTIFIED BY 'DevPassword123!';
#   GRANT ALL PRIVILEGES ON acin_db_dev.* TO 'acin_dev'@'localhost';
#   FLUSH PRIVILEGES; EXIT;
#
#   mysql -u acin_dev -p acin_db_dev < database/schema.sql
#   mysql -u acin_dev -p acin_db_dev < database/seed.sql
#
# Production — run once on your server (NO seed.sql in production):
#
#   CREATE DATABASE acin_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'acin_prod'@'localhost' IDENTIFIED BY '<strong-unique-password>';
#   GRANT ALL PRIVILEGES ON acin_db.* TO 'acin_prod'@'localhost';
#   FLUSH PRIVILEGES; EXIT;
#
#   mysql -u acin_prod -p acin_db < database/schema.sql
#
# Note: database/migrations/ contains historical ALTER TABLE scripts.
# They are NOT needed for a fresh install — schema.sql is the single source of truth.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=acin_db_dev           # dev: acin_db_dev  |  prod: acin_db
DB_USER=acin_dev              # dev: acin_dev      |  prod: acin_prod
DB_PASSWORD=your_password_here


# ── Session ───────────────────────────────────────────────────────────────────
#
# Use a DIFFERENT secret for dev and production — never share them.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Sessions are stored in MySQL. The `sessions` table is created automatically
# on first server startup — no manual SQL needed.

SESSION_SECRET=replace-with-a-64-byte-random-hex-string
SESSION_MAX_AGE_MS=604800000
